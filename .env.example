# Copy this file to .env and replace values locally.
# Never commit real credentials or secrets.

PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/CMA_DATABASE

# Must match an existing least-privilege role_id in the roles table.
# Do not configure an administrator role for public registration.
DEFAULT_ROLE_ID=SET_TO_AN_EXISTING_ROLE_ID_FROM_ROLES_TABLE

# Use distinct, random secrets of at least 32 characters.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
REFRESH_SECRET=use_a_different_long_random_secret_at_least_32_chars
REFRESH_EXPIRES_IN=7d
