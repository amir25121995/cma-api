# Copy this file to .env and replace values locally.
# Never commit real credentials or secrets.

PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/CMA_DATABASE

# Generate distinct, random secrets for access and refresh tokens.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m
REFRESH_SECRET=replace_with_a_different_long_random_secret
REFRESH_EXPIRES_IN=7d
